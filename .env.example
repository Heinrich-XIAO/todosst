# Convex — local dev
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211
# For production, these are auto-set after `npx convex deploy`
# NEXT_PUBLIC_CONVEX_URL=https://<your-deployment>.convex.cloud
# NEXT_PUBLIC_CONVEX_URL and CONVEX_DEPLOYMENT set via Convex dashboard

# Convex Auth — no custom domain needed, works on *.vercel.app
# For local dev the CLI already set these via `npx @convex-dev/auth`:
# SITE_URL=http://localhost:3000
# JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----...
# JWKS={"keys":[...]}
# In production (Vercel), set SITE_URL to your Vercel URL:
# SITE_URL=https://your-app.vercel.app
# JWT_PRIVATE_KEY and JWKS must be copied from `npx convex env list` to Vercel env vars

# Required for email verification — Resend
# Get key at https://resend.com/api-keys (free, works on .vercel.app)
# After signup, an 8-digit code is emailed — user must verify before first sign-in
# AUTH_RESEND_KEY=re_xxx
# AUTH_EMAIL_FROM="todosst <onboarding@resend.dev>"

# Convex — local dev
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211
# For production, these are auto-set after `npx convex deploy`
# NEXT_PUBLIC_CONVEX_URL=https://<your-deployment>.convex.cloud
# NEXT_PUBLIC_CONVEX_URL and CONVEX_DEPLOYMENT set via Convex dashboard

# Convex Auth — no custom domain needed, works on *.vercel.app
# For local dev the CLI already set these via `npx @convex-dev/auth`:
# SITE_URL=http://localhost:3000
# JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----...
# JWKS={"keys":[...]}
# In production (Vercel), set SITE_URL to your Vercel URL:
# SITE_URL=https://your-app.vercel.app
# JWT_PRIVATE_KEY and JWKS must be copied from `npx convex env list` to Vercel env vars

# Web Push (VAPID) — without these, NO push notification of any kind can be
# delivered (reminders, daily nudge, dateless auto-nudge all go through it):
# - generate once: node -e + WebCrypto P-256, or `npx web-push generate-vapid-keys`
#   (public = base64url of the 65-byte uncompressed point,
#   private = base64url of the 32-byte scalar)
# - backend (Convex env, secret): VAPID_PUBLIC_KEY + VAPID_PRIVATE_KEY
#   local:  `npx convex env set VAPID_PUBLIC_KEY <public>`
#           `npx convex env set VAPID_PRIVATE_KEY <private>`
#   prod:   Convex dashboard → Environment Variables (deployed via `npx convex deploy`)
# - frontend (public by design): NEXT_PUBLIC_VAPID_PUBLIC_KEY=<same public key>
#   local:  .env.local — prod: Vercel project → Environment Variables

